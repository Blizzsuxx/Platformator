{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Configure Platformator Debug",
            "command": "/usr/bin/cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Build Platformator Debug",
            "command": "/usr/bin/cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Configure Platformator Debug"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Configure and build the Platformator Debug preset into bin/."
        },
        {
            "type": "shell",
            "label": "Build Mario Example Debug",
            "command": "/usr/bin/cmake",
            "args": [
                "--build",
                "--preset",
                "debug",
                "--target",
                "mario_example"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Configure Platformator Debug"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure and build only the Mario example target into bin/."
        }
    ]
}