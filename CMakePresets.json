{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/bin/default",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/default"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/bin/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORMATOR_ENABLE_DEBUG_TOOLS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/debug"
            }
        },
        {
            "name": "production",
            "displayName": "Production",
            "inherits": "default",
            "binaryDir": "${sourceDir}/bin/production",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORMATOR_ENABLE_DEBUG_TOOLS": "OFF",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/production"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "inherits": "default",
            "binaryDir": "${sourceDir}/bin/relwithdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORMATOR_ENABLE_DEBUG_TOOLS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/relwithdebinfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug"
        },
        {
            "name": "production",
            "displayName": "Production",
            "configurePreset": "production"
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo"
        }
    ]
}