{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "PLATFORMATOR_BUILD_EDITOR": "ON",
        "PLATFORMATOR_BUILD_BENCHMARKS": "OFF",
        "PLATFORMATOR_SANITIZER": "none",
        "PLATFORMATOR_INSTALL": "ON"
      }
    },
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "PLATFORMATOR_BUILD_EDITOR": "ON",
        "PLATFORMATOR_BUILD_BENCHMARKS": "OFF",
        "PLATFORMATOR_SANITIZER": "none",
        "PLATFORMATOR_INSTALL": "ON"
      }
    },
    {
      "name": "test",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "PLATFORMATOR_BUILD_EDITOR": "ON",
        "PLATFORMATOR_BUILD_BENCHMARKS": "OFF",
        "PLATFORMATOR_SANITIZER": "none",
        "PLATFORMATOR_INSTALL": "OFF"
      }
    },
    {
      "name": "benchmark",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/benchmark",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "PLATFORMATOR_BUILD_EDITOR": "ON",
        "PLATFORMATOR_BUILD_BENCHMARKS": "ON",
        "PLATFORMATOR_SANITIZER": "none",
        "PLATFORMATOR_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "test",
      "configurePreset": "test"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "filter": {
        "exclude": {
          "name": "platformator_package_smoke"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
