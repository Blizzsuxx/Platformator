object {
    name "Main Camera"
    camera {
        viewport 0 0 640 480
    }
}

object {
    name "Ball"
    position 320 240
    rigidbody {
        bodyType dynamic
        gravity true
        mass 10
        velocity 200 150
        force 0 0
        angularVelocity 0
        torque 0
        friction 1
        restitution 0
    }
    boxCollider {
        height 50
        width 50
        trigger false
        collisionGroup 1
        collisionMask 1
    }
    sprite {
        path "../ball.png"
        flip none
        size 50 50
    }
}

