format = "platformator_scene"
version = 1

[[objects]]
name = "Main Camera"

[objects.camera]
viewport = [0, 0, 640, 480]

[[objects]]
name = "Ball"
position = [320, 240]

[objects.rigidbody]
bodyType = "dynamic"
gravity = true
mass = 10
velocity = [200, 150]
force = [0, 0]
angularVelocity = 0
torque = 0
friction = 1
restitution = 0

[objects.boxCollider]
height = 50
width = 50
trigger = false
collisionGroup = 1
collisionMask = 1

[objects.sprite]
path = "../ball.png"
flip = "none"
size = [50, 50]

[[objects]]
name = "Wall South"
position = [320, 455]

[objects.rigidbody]
bodyType = "static"
gravity = false
mass = 1
velocity = [0, 0]
force = [0, 0]
angularVelocity = 0
torque = 0
friction = 1
