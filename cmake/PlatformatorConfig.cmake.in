@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_platformator_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(SDL3 CONFIG HINTS "${_platformator_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/SDL3")
find_dependency(SDL3_mixer CONFIG HINTS "${_platformator_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/SDL3_mixer")
find_dependency(SDL3_image CONFIG HINTS "${_platformator_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/SDL3_image")
find_dependency(SDL3_ttf CONFIG HINTS "${_platformator_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/SDL3_ttf")
find_dependency(TBB CONFIG HINTS "${_platformator_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/TBB")
find_dependency(Eigen3 CONFIG HINTS "${_platformator_prefix}/share/eigen3/cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PlatformatorTargets.cmake")
set(Platformator_ASSET_DIR "${_platformator_prefix}/assets")
check_required_components(Platformator)
