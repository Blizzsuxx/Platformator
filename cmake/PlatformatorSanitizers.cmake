set(PLATFORMATOR_SANITIZER "none" CACHE STRING "none, address-undefined or thread")
set_property(CACHE PLATFORMATOR_SANITIZER PROPERTY STRINGS none address-undefined thread)
if(NOT PLATFORMATOR_SANITIZER MATCHES "^(none|address-undefined|thread)$")
    message(FATAL_ERROR "Unknown PLATFORMATOR_SANITIZER: ${PLATFORMATOR_SANITIZER}")
endif()
if(NOT PLATFORMATOR_SANITIZER STREQUAL "none")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        message(FATAL_ERROR "PLATFORMATOR_SANITIZER requires GCC or Clang")
    endif()
    if(PLATFORMATOR_SANITIZER STREQUAL "thread")
        if(DEFINED TBB_SANITIZE AND NOT TBB_SANITIZE STREQUAL "" AND NOT TBB_SANITIZE STREQUAL "thread")
            message(FATAL_ERROR "ThreadSanitizer requires TBB_SANITIZE=thread")
        endif()
        set(TBB_SANITIZE thread CACHE STRING "Instrument TBB alongside the engine" FORCE)
        # GCC warns that TSan cannot model atomic_thread_fence. Keep that warning
        # visible without letting the vendor's -Werror prevent an instrumented run.
        set(TBB_STRICT OFF CACHE BOOL "Allow visible compiler warnings in instrumented TBB" FORCE)
        set(platformator_sanitizer_flags -fsanitize=thread)
    else()
        if(DEFINED TBB_SANITIZE AND NOT TBB_SANITIZE STREQUAL "" AND NOT TBB_SANITIZE STREQUAL "address,undefined")
            message(FATAL_ERROR "Address/UBSan cannot use a different TBB sanitizer")
        endif()
        set(platformator_sanitizer_flags -fsanitize=address,undefined)
    endif()
    # Apply before adding dependencies: concurrency diagnostics need instrumented
    # TBB, and resource lifetime tests also cross the SDL boundary.
    add_compile_options(${platformator_sanitizer_flags} -fno-omit-frame-pointer)
    add_link_options(${platformator_sanitizer_flags})
endif()
