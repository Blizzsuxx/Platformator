function(platformator_add_test name source)
    cmake_parse_arguments(TEST "INTERNAL" "" "LABELS" ${ARGN})
    add_executable(${name} "${PROJECT_SOURCE_DIR}/${source}")
    target_link_libraries(${name} PRIVATE Platformator::platformator)
    if(TEST_INTERNAL)
        target_include_directories(${name} PRIVATE
            "${PROJECT_SOURCE_DIR}/src" "${PROJECT_BINARY_DIR}/generated")
    endif()
    add_test(NAME ${name} COMMAND ${name})
    set_tests_properties(${name} PROPERTIES
        LABELS "platformator;${TEST_LABELS}"
        ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;SDL_RENDER_DRIVER=software")
endfunction()

function(platformator_add_spatial_test name source)
    cmake_parse_arguments(TEST "INTERNAL" "" "LABELS" ${ARGN})
    if(TEST_INTERNAL)
        platformator_add_test(${name} ${source} INTERNAL LABELS spatial ${TEST_LABELS})
    else()
        platformator_add_test(${name} ${source} LABELS spatial ${TEST_LABELS})
    endif()
endfunction()

function(platformator_add_spatial_python_test name source)
    if(NOT Python3_Interpreter_FOUND)
        message(FATAL_ERROR "Python3 must be found before registering spatial Python tests")
    endif()
    add_test(NAME ${name} COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/${source}")
    set_tests_properties(${name} PROPERTIES LABELS "platformator;spatial;python")
endfunction()
