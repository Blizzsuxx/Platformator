object {
    name "Main Camera"
    camera {
        viewport 0 0 640 480
    }
}

object {
    name "BGM"
    tag "audio"
    audio {
        path "assets/audio/music.wav"
        autoplay true
        loops -1
        gain 0.5
    }
}

object {
    name "SFX Jump"
    tag "audio"
    audio {
        path "assets/audio/jump.wav"
        autoplay false
        loops 0
        gain 0.9
    }
}

object {
    name "SFX Coin"
    tag "audio"
    audio {
        path "assets/audio/coin.wav"
        autoplay false
        loops 0
        gain 0.85
    }
}

object {
    name "SFX Stomp"
    tag "audio"
    audio {
        path "assets/audio/stomp.wav"
        autoplay false
        loops 0
        gain 0.9
    }
}

object {
    name "SFX Hurt"
    tag "audio"
    audio {
        path "assets/audio/hurt.wav"
        autoplay false
        loops 0
        gain 0.9
    }
}

object {
    name "SFX Win"
    tag "audio"
    audio {
        path "assets/audio/win.wav"
        autoplay false
        loops 0
        gain 0.95
    }
}

object {
    name "Player"
    tag "player"
    position 120 408
    rigidbody {
        bodyType kinematic
        gravity false
        mass 3
        velocity 0 0
        force 0 0
        angularVelocity 0
        torque 0
        friction 0.6
        restitution 0
    }
    boxCollider {
        size 28 32
        trigger false
        collisionGroup 1
        collisionMask 1
    }
    sprite {
        path "assets/player/idle_0.png"
        flip none
        size 32 32
    }
    animator {
        play "idle"
        playbackSpeed 1
        clip {
            name "idle"
            fps 4
            loop true
            size 32 32
            frame "assets/player/idle_0.png"
            frame "assets/player/idle_1.png"
        }
        clip {
            name "run"
            fps 12
            loop true
            size 32 32
            frame "assets/player/run_0.png"
            frame "assets/player/run_1.png"
            frame "assets/player/run_2.png"
        }
        clip {
            name "jump"
            fps 1
            loop false
            size 32 32
            frame "assets/player/jump.png"
        }
        clip {
            name "fall"
            fps 1
            loop false
            size 32 32
            frame "assets/player/fall.png"
        }
        clip {
            name "win"
            fps 4
            loop true
            size 32 32
            frame "assets/player/idle_0.png"
            frame "assets/player/idle_1.png"
        }
    }
}

