object {
    name "Coin A"
    tag "coin"
    position 520 316
    rigidbody {
        bodyType static
        gravity false
        mass 1
        velocity 0 0
        force 0 0
        angularVelocity 0
        torque 0
        friction 0
        restitution 0
    }
    circleCollider {
        radius 10
        trigger true
        collisionGroup 1
        collisionMask 1
    }
    sprite {
        path "assets/items/coin_0.png"
        flip none
        size 22 22
    }
    animator {
        play "spin"
        playbackSpeed 1
        clip {
            name "spin"
            fps 10
            loop true
            size 22 22
            frame "assets/items/coin_0.png"
            frame "assets/items/coin_1.png"
            frame "assets/items/coin_2.png"
            frame "assets/items/coin_3.png"
        }
    }
}

