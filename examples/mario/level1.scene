object {
    name "Main Camera"
    camera {
        viewport 0 0 640 480
    }
}

object {
    name "Player"
    tag "player"
    position 120 408
    rigidbody {
        bodyType kinematic
        gravity false
        mass 3
        velocity 0 0
        force 0 0
        angularVelocity 0
        torque 0
        friction 0.6
        restitution 0
    }
