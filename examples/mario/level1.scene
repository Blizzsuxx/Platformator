format = "platformator_scene"
version = 1

[[objects]]
name = "Main Camera"

[objects.camera]
viewport = [0, 0, 640, 480]

[[objects.scripts]]
type = "MarioCameraRig"
target = "Player"
cameralead = 90
levelwidth = 2240

[[objects]]
name = "BGM"
tag = "audio"

[objects.audio]
path = "assets/audio/music.wav"
autoplay = true
loops = -1
gain = 0.5

[[objects]]
name = "Player"
tag = "player"
position = [120, 408]

[objects.rigidbody]
bodyType = "kinematic"
gravity = false
mass = 3
velocity = [0, 0]
force = [0, 0]
angularVelocity = 0
torque = 0
friction = 0.6
restitution = 0

[objects.boxCollider]
size = [28, 32]
trigger = false
collisionGroup = 1
collisionMask = 1

[objects.sprite]
path = "assets/player/idle_0.png"
flip = "none"
size = [32, 32]

[objects.audio]
gain = 0.9

[objects.animator]
playbackSpeed = 1

[[objects.scripts]]
type = "MarioPlayer"
walkspeed = 180
jumpspeed = 250
gravity = 358.065
maxfallspeed = 460
stompbouncefactor = 0.65
idleAnimset = "assets/animations/player.animset"
runAnimset = "assets/animations/player_run.animset"
jumpAnimset = "assets/animations/player_jump.animset"
fallAnimset = "assets/animations/player_fall.animset"
winAnimset = "assets/animations/player_win.animset"
jumpSound = "assets/audio/jump.wav"
hurtSound = "assets/audio/hurt.wav"

