object {
    name "Goomba A"
    tag "enemy"
    position 640 418
    rigidbody {
        bodyType kinematic
        gravity false
        mass 1
        velocity -55 0
        force 0 0
        angularVelocity 0
        torque 0
        friction 0.8
        restitution 0
    }
    boxCollider {
        size 28 28
        trigger false
        collisionGroup 1
        collisionMask 1
    }
    sprite {
        path "assets/enemies/walk_0.png"
        flip none
        size 32 32
    }
    audio {
        gain 0.9
    }
    animator {
        playbackSpeed 1
    }
    script {
        type "MarioPatrolEnemy"
        minx 550
        maxx 730
        direction -1
        walkspeed 55
        stompminspeed 10
        stomptolerance 14
        squashduration 0.28
        walkAnimset "assets/animations/goomba.animset"
        squashAnimset "assets/animations/goomba_squash.animset"
        stompSound "assets/audio/stomp.wav"
    }
}

